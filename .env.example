# ===========================
# Global Environment Variables
# ===========================

# Application
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/volunteer_portal
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/volunteer_portal

# Authentication
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
FRONTEND_URL=http://localhost:3000

# Email (Optional — stubbed by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI Matching (Optional)
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
