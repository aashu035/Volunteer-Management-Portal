# Backend Environment Variables
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/volunteer_portal
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/volunteer_portal

# Authentication
JWT_SECRET=dev-secret-change-in-production-256-bit-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Email (stubbed — set these for real SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI Matching (optional)
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
